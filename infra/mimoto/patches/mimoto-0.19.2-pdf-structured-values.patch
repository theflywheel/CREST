+        String provenanceText = ReflectionTestUtils.invokeMethod(
+                credentialPDFGeneratorService, "formatValue", provenance, "en");
+        String outcomeText = ReflectionTestUtils.invokeMethod(
+                credentialPDFGeneratorService, "formatValue",
+                new LinkedHashMap<>(Map.of("value", 0, "unit", "bednets")), "en");
