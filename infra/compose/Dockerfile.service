# Build the selected service; shared dependencies retain their Docker cache.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
ARG REVISION=development
ARG SERVICE
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/theflywheel/crest/pkg/httpx.BuildRevision=${REVISION}" -o /out/service ./services/${SERVICE}
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/healthcheck ./tools/healthcheck

# Distroless-style final image: no shell, nothing to pivot to if a service is
# compromised. The healthcheck is a binary for the same reason — there is no curl.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /crest-service
COPY --from=build /out/healthcheck /crest-healthcheck
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/crest-service"]
