# One Dockerfile for all seven CREST services; SERVICE selects which.
#
# Every layer up to and including the compile is identical across the seven
# builds — ARG SERVICE is deliberately introduced only after it — so BuildKit
# compiles the module once and the other six builds reuse the layer. Before
# this ordering, a seven-service `compose build` was seven full module
# compiles; it is the difference between ~7 minutes and ~2 in CI.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ ./services/... ./tools/healthcheck
ARG SERVICE
RUN cp /out/${SERVICE} /out/service

# Distroless-style final image: no shell, nothing to pivot to if a service is
# compromised. The healthcheck is a binary for the same reason — there is no curl.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /crest-service
COPY --from=build /out/healthcheck /crest-healthcheck
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/crest-service"]
