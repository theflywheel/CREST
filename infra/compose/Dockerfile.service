# One Dockerfile for all seven CREST services; SERVICE selects which.
FROM golang:1.25-alpine AS build
ARG SERVICE
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service ./services/${SERVICE} \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/healthcheck ./tools/healthcheck

# Distroless-style final image: no shell, nothing to pivot to if a service is
# compromised. The healthcheck is a binary for the same reason — there is no curl.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /crest-service
COPY --from=build /out/healthcheck /crest-healthcheck
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/crest-service"]
