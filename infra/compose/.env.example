# Copy to .env and adjust. Never commit .env.

# ── Upstream images — tags VERIFIED against Docker Hub 2026-08-22 (#1, #3) ───
# Each tag below was checked to exist and to publish a linux/arm64 manifest
# unless noted. Anything that turns out to be wrong in use is a finding for the
# memo (#4), not a compose bug.
INJI_CERTIFY_IMAGE=mosipid/inji-certify-with-plugins:0.14.0
ESIGNET_IMAGE=mosipid/esignet-with-plugins:1.8.0
ESIGNET_MOCK_IMAGE=mosipid/mock-identity-system:0.13.0
REDIS_IMAGE=redis:7-alpine

# FINDING: `mosipid/inji-verify` is not one image. Upstream splits it into a
# service and a UI, and the tag we had guessed (0.11.0) does not exist at all —
# that repository stops at 0.10.0 and was last pushed in October 2024. The live
# components are these two, on their own version line.
INJI_VERIFY_SERVICE_IMAGE=mosipid/inji-verify-service:0.16.0
# amd64 only. On Apple Silicon this runs under emulation, which is acceptable
# for a UI and NOT acceptable for anything we measure.
INJI_VERIFY_UI_IMAGE=mosipid/inji-verify-ui:0.16.0

# Inji Web — the browser wallet. Needed for #1's issue → hold → verify path when
# no phone is to hand; the mobile wallet is an app store artefact, not an image.
INJI_WEB_IMAGE=mosipid/inji-web:0.15.0

# DeDi-node ships as a published multi-arch image. (An earlier note here said
# no image existed — that was wrong: it was published under `flywheelai`, not
# under the GitHub org name.) Pinned to a digest tag rather than `latest` so a
# node upgrade is a commit, not a surprise on restart.
DEDI_IMAGE=flywheelai/dedi-node:sha-2d020a3

# ── Local only. Real secrets come from the deployment's secret store. ────────
POSTGRES_PASSWORD=crest
S3_ACCESS_KEY=crest-local
S3_SECRET_KEY=crest-local-secret

# ── Host ports (override if something already owns one) ─────────────────────
POSTGRES_PORT=55432
S3_PORT=58333
DEDI_PORT=58081
CERTIFY_PORT=58090
VERIFY_SERVICE_PORT=58091
VERIFY_UI_PORT=58092
INJI_WEB_PORT=58093
ESIGNET_PORT=58088
ESIGNET_MOCK_PORT=58082
REDIS_PORT=56379
REGISTRY_PORT=59001
DEFINITIONS_PORT=59002
EVIDENCE_PORT=59003
CONFIRMATION_PORT=59004
VERIFICATION_PORT=59005
PAYMENTS_PORT=59006
NOTIFY_PORT=59007
MOCK_SMS_PORT=59101
MOCK_RAIL_PORT=59102

# The bucket consent artefacts live in. Created on first use by the harness;
# a real deployment creates it with whatever lifecycle and retention policy
# the country's data protection arrangement requires.
S3_BUCKET=crest-artefacts
