# Copy to .env and adjust. Never commit .env.

# ── UNVERIFIED until the P0 spike ────────────────────────────────────────────
# These tags are our best current guess. #1 (Inji) and #3 (eSignet) confirm them
# and record anything that differs in the findings memo (#4). A wrong tag here
# is a P0 finding, not a compose bug.
INJI_CERTIFY_IMAGE=mosipid/inji-certify:0.11.0
INJI_VERIFY_IMAGE=mosipid/inji-verify:0.11.0
ESIGNET_IMAGE=mosipid/esignet:1.5.0
ESIGNET_MOCK_IMAGE=mosipid/mock-identity-system:0.10.0

# DeDi-node: built from theflywheel/DeDi-node. Until a published image exists,
# build it locally and retag, or point this at your registry.
DEDI_IMAGE=ghcr.io/theflywheel/dedi-node:latest

# ── Local only. Real secrets come from the deployment's secret store. ────────
POSTGRES_PASSWORD=crest
S3_ACCESS_KEY=crest-local
S3_SECRET_KEY=crest-local-secret

# ── Host ports (override if something already owns one) ─────────────────────
POSTGRES_PORT=55432
S3_PORT=58333
DEDI_PORT=58081
CERTIFY_PORT=58090
VERIFY_PORT=58091
ESIGNET_PORT=58088
ESIGNET_MOCK_PORT=58082
REGISTRY_PORT=59001
DEFINITIONS_PORT=59002
EVIDENCE_PORT=59003
CONFIRMATION_PORT=59004
VERIFICATION_PORT=59005
PAYMENTS_PORT=59006
NOTIFY_PORT=59007
MOCK_SMS_PORT=59101
MOCK_RAIL_PORT=59102
