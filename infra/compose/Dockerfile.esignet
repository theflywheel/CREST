# eSignet, with the upstream entrypoint replaced.
#
# Thin on purpose: same jar, same plugins, same profile — only the startup
# script differs. See infra/compose/esignet-start.sh for why, and
# docs/p0-findings.md for what it means for a real deployment.
#
# ESIGNET_IMAGE is pinned in infra/compose/.env.example. Overriding it here
# means the Dockerfile and compose can never disagree about the version.
ARG ESIGNET_IMAGE=mosipid/esignet-with-plugins:1.8.0
FROM ${ESIGNET_IMAGE}

COPY --chmod=0755 infra/compose/esignet-start.sh /home/mosip/esignet-start.sh

# The keystore directory, created with the right ownership so that a named
# volume mounted here inherits it. Docker seeds an empty named volume from the
# image, and creates a bare mount point owned by root if the path does not
# exist — which eSignet, running as uid 1001, then cannot write to.
#
# The keystore itself must persist: the key aliases that point into it live in
# the database, and a container recreated without it fails to start with
# `No such alias`. See docs/p0-findings.md.
USER root
RUN mkdir -p /home/mosip/keys && chown mosip:mosip /home/mosip/keys
USER 1001

ENTRYPOINT ["/bin/bash", "/home/mosip/esignet-start.sh"]
