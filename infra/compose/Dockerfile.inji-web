# Inji Web — the browser wallet.
#
# #1 needs somewhere to hold a credential. The mobile wallet ships through app
# stores rather than as an image, so this is the holder a deployment can
# actually stand up; the mobile leg, and the printed card with it, still needs a
# real device.
#
# The wallet reads the SAME issuer and verifier documents Mimoto does — they are
# served to the browser from /home/mosip — so a mismatch between what the wallet
# offers and what its backend will accept cannot happen by drift.
ARG INJI_WEB_IMAGE=mosipid/inji-web:0.15.0
FROM ${INJI_WEB_IMAGE}

COPY infra/injiweb/nginx.conf                           /etc/nginx/conf.d/default.conf
COPY infra/mimoto/config/mimoto-issuers-config.json     /home/mosip/mimoto-issuers-config.json
COPY infra/mimoto/config/mimoto-trusted-verifiers.json  /home/mosip/mimoto-trusted-verifiers.json

COPY --chmod=0755 infra/injiweb/injiweb-start.sh        /injiweb-start.sh

EXPOSE 3004

# The client id is substituted at start, not at build. See injiweb-start.sh.
ENTRYPOINT ["/bin/sh", "/injiweb-start.sh"]
