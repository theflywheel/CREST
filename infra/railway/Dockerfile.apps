# The journey apps on Railway: a second product door, separate from crest-web
# (the PoC, shared externally and left untouched). nginx serves the four apps
# and their shared design system, and proxies /api/<service>/ over private
# networking — the same §16 service-identity fence as crest-web: /internal/*
# is refused HERE and the Go services carry no public domains.
#
# Since #148 this image also carries the documentation at /docs/: the four
# technical sections under docs/ (ARCHITECTURE, FLOWS, PLUGINS,
# BUILDING_ON_CREST) and their index, rendered by Quartz (jackyzha0/quartz,
# pinned v4.5.2). The design documents and working notes stay in the
# repository. Quartz is a build tool here, not a dependency of the repo: it is
# cloned at image build and nothing of it ships except the static output.
FROM node:22-alpine AS docs
RUN apk add --no-cache git
RUN git clone --depth 1 --branch v4.5.2 https://github.com/jackyzha0/quartz.git /quartz
WORKDIR /quartz
RUN npm ci --no-audit --no-fund
# The hosted site is the four technical sections and their index, nothing
# else: the design documents and working notes stay in the repository, and
# the pages name them where they apply rather than linking out.
COPY docs/INDEX.md /docs/INDEX.md
COPY docs/ARCHITECTURE /docs/ARCHITECTURE
COPY docs/FLOWS /docs/FLOWS
COPY docs/PLUGINS /docs/PLUGINS
COPY docs/BUILDING_ON_CREST /docs/BUILDING_ON_CREST
COPY infra/railway/quartz-theme.mjs /quartz/quartz-theme.mjs
RUN rm -rf content && mkdir content \
    && cp /docs/INDEX.md content/index.md \
    && for d in ARCHITECTURE FLOWS PLUGINS BUILDING_ON_CREST; do \
         cp -r /docs/$d content/$d && mv content/$d/README.md content/$d/index.md; \
       done \
    # The subpath in baseUrl is what makes Quartz emit /docs/-rooted links.
    && sed -i 's/pageTitle: "Quartz 4"/pageTitle: "CREST Documentation"/; s#baseUrl: "quartz.jzhao.xyz"#baseUrl: "crest-apps-production.up.railway.app/docs"#' quartz.config.ts \
    # Retheme to the CREST design system (frontend/packages/ui/src/styles.css); the script
    # fails the build if the pinned Quartz defaults are not found verbatim.
    && node quartz-theme.mjs \
    && node ./quartz/bootstrap-cli.mjs build \
    # A section's README.md became its index page; links written for GitHub
    # still say README, so answer that name too.
    && for d in ARCHITECTURE FLOWS PLUGINS BUILDING_ON_CREST; do cp public/$d/index.html public/$d/README.html; done

# The rebuilt doors (React/Vite, frontend/ pnpm workspace) build here; doors
# not yet ported keep shipping as the static files under apps/.
FROM node:22-alpine AS webapps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY frontend /frontend
WORKDIR /frontend
RUN pnpm install --frozen-lockfile && pnpm -r build

FROM nginx:1.27-alpine
COPY apps/index.html   /usr/share/nginx/html/index.html
# The JSON-LD context the wallet credential's signature depends on (#155
# phase C): canonicalisation for Ed25519Signature2020 dereferences it at
# signing AND verification time, so it must be served from a stable origin.
COPY apps/contexts     /usr/share/nginx/html/contexts
COPY frontend/packages/ui/src/styles.css /usr/share/nginx/html/crest.css
COPY --from=webapps /frontend/apps/worker/dist /usr/share/nginx/html/worker
COPY --from=webapps /frontend/apps/verify/dist /usr/share/nginx/html/verify
COPY --from=webapps /frontend/apps/field/dist /usr/share/nginx/html/enrolment
COPY --from=webapps /frontend/apps/console/dist /usr/share/nginx/html/console
COPY --from=docs /quartz/public /usr/share/nginx/html/docs
COPY infra/railway/nginx.apps.conf.template /etc/nginx/templates/default.conf.template
# Railway injects PORT; the stock nginx entrypoint substitutes ${PORT}.
