# Railway private networking is IPv6 and its DNS answers on fd12::10; the
# resolver + variable upstream force per-request resolution, because internal
# addresses change on redeploys.
resolver [fd12::10] valid=10s;

server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # The fence (#102, §16 service-identity ruling): the service-only routes
    # do not exist as far as the internet is concerned.
    location ~ ^/api/[a-z-]+/internal/ { return 404; }

    # The fence's second half: the first refuses /internal/*, this one refuses
    # hosts that are not CREST's — the Railway project is shared, and an open
    # (?<svc>[a-z-]+) would proxy to any service in it. crest-mock-oidc stays
    # listed deliberately: it is the demo's login.
    location ~ ^/api/(?<svc>crest-(registry|definitions|evidence|confirmation|verification|payments|notify|mock-oidc))/(?<rest>.*)$ {
        set $upstream http://$svc.railway.internal:8080/$rest$is_args$args;
        proxy_pass $upstream;
        proxy_set_header Host $svc.railway.internal;
        proxy_read_timeout 30s;
    }

    # An /api/ name the allowlist refused must 404, not fall through to the
    # SPA fallback and answer 200 with index.html.
    location ~ ^/api/ { return 404; }

    location / { try_files $uri /index.html; }
}
