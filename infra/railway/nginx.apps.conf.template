# Railway private networking is IPv6 and its DNS answers on fd12::10; the
# resolver + variable upstream force per-request resolution, because internal
# addresses change on redeploys.
resolver [fd12::10] valid=10s;

limit_req_zone $binary_remote_addr zone=crest_api:10m rate=20r/s;

server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 65m;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # The fence (#102, §16 service-identity ruling): the service-only routes
    # do not exist as far as the internet is concerned.
    location ~ ^/api/[a-z-]+/internal/ { return 404; }

    # The fence's second half: the first refuses /internal/*, this one refuses
    # hosts that are not CREST's — the Railway project is shared, and an open
    # (?<svc>[a-z-]+) would proxy to any service in it.
    # Alias names for links already in the wild: the four member names
    # answer from crest-core since #150, and crest-confirmation answers from
    # the payments application since #129. The old names proxy rather than
    # 404 on stakeholders.
    location ~ ^/api/crest-(registry|definitions|evidence|verification)/(?<crest>.*)$ {
        set $upstream http://crest-core.railway.internal:8080/$crest$is_args$args;
        proxy_pass $upstream;
        limit_req zone=crest_api burst=40 nodelay;
        proxy_set_header Host crest-core.railway.internal;
        proxy_read_timeout 30s;
    }
    location ~ ^/api/crest-confirmation/(?<crest>.*)$ {
        set $upstream http://crest-core.railway.internal:8080/$crest$is_args$args;
        proxy_pass $upstream;
        limit_req zone=crest_api burst=40 nodelay;
        proxy_set_header Host crest-core.railway.internal;
        proxy_read_timeout 30s;
    }

    location ~ ^/api/(?<svc>crest-(core|payments))/(?<rest>.*)$ {
        set $upstream http://$svc.railway.internal:8080/$rest$is_args$args;
        proxy_pass $upstream;
        limit_req zone=crest_api burst=40 nodelay;
        proxy_set_header Host $svc.railway.internal;
        proxy_read_timeout 30s;
    }

    # An /api/ name the allowlist refused must 404, not fall through to the
    # app fallback and answer 200 with index.html.
    location ~ ^/api/ { return 404; }

    # The design docs live under /docs/ since #148. Quartz links pages
    # without extensions (/docs/DEMO for DEMO.html); the raw HTML design docs
    # keep theirs. Serve both.
    location /docs/ { try_files $uri $uri.html $uri/index.html =404; }

    # Multi-app door: each app is a directory with its own index.html; hash
    # routing means no history fallback is needed. $uri/ (which crest-web's
    # single-app fallback lacks) is what lets /worker/ resolve to its index.
    location / { try_files $uri $uri/ =404; }
}
