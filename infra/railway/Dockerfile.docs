# The design docs, hosted: docs/*.md rendered by Quartz (jackyzha0/quartz,
# pinned v4.5.2), with the self-contained HTML design docs — the blueprint
# among them — copied in beside the rendered pages so the index's relative
# links (`crest-infrastructure-blueprint.html`) keep resolving. Quartz itself
# is a build tool here, not a dependency of the repo: it is cloned at image
# build and nothing of it ships except the static output.
FROM node:22-alpine AS build
RUN apk add --no-cache git
RUN git clone --depth 1 --branch v4.5.2 https://github.com/jackyzha0/quartz.git /quartz
WORKDIR /quartz
RUN npm ci --no-audit --no-fund
COPY docs/*.md /docs/
COPY docs/*.html /docs/
COPY infra/railway/quartz-theme.mjs /quartz/quartz-theme.mjs
# docs/README.md is the index of the design docs, so it becomes the site root.
RUN rm -rf content && mkdir content \
    && cp /docs/*.md content/ && mv content/README.md content/index.md \
    # Quartz titles a page by filename unless frontmatter says otherwise, and
    # the site root should not be called "index".
    && printf -- '---\ntitle: CREST design documents\n---\n' > /tmp/fm \
    && cat /tmp/fm content/index.md > /tmp/ix && mv /tmp/ix content/index.md \
    && sed -i 's/pageTitle: "Quartz 4"/pageTitle: "CREST Design Docs"/; s#baseUrl: "quartz.jzhao.xyz"#baseUrl: "crest-docs-production.up.railway.app"#' quartz.config.ts \
    # Retheme to the CREST design system (apps/shared/crest.css); the script
    # fails the build if the pinned Quartz defaults are not found verbatim.
    && node quartz-theme.mjs \
    && node ./quartz/bootstrap-cli.mjs build \
    && cp /docs/*.html public/

FROM nginx:1.27-alpine
COPY --from=build /quartz/public /usr/share/nginx/html
COPY infra/railway/nginx.docs.conf.template /etc/nginx/templates/default.conf.template
# Railway injects PORT; the stock nginx entrypoint substitutes ${PORT}.
