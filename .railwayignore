# Never upload to the builder. Key material and local state above all — an
# upload is a copy, and a copy of a signing key is a signing key.
infra/compose/dedi-keys/
.env
*.key
node_modules/
docs/reference/
.claude/

# Locally built service binaries. They are gitignored but `railway up` uploads
# the working directory, not the git tree — 80MB of Go binaries per deploy,
# rebuilt inside the image anyway.
/registry
/parties
/definitions
/evidence
/confirmation
/verification
/payments
/notify

# The docs image fetches the recordings it serves from GitHub at build time
# (infra/railway/Dockerfile.apps); nothing under docs/assets is uploaded to
# the builder, which keeps the upload far under Railway's size limit.
docs/assets/
