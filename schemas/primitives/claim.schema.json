{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crest:schema:primitives:claim:1",
  "title": "Claim",
  "description": "Party P performed (part of) Unit U \u2014 zero, one or many per unit. The only place actor and activity meet.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/id"
    },
    "unitId": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/id"
    },
    "partyId": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/did"
    },
    "share": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "Portion of the unit attributed to this party. Absent means the whole of it."
    },
    "matched": {
      "type": "object",
      "description": "How this claim came to be attached to this worker, and how confident that is \u2014 provenance the strength function and the unclear queue both read (\u00a74.1). `manual` is a person working the unclear queue naming the worker, not a key match: it carries confidence 1 because somebody asserted it, and a reader that treats it as equivalent to a national-id-hash match is reading an assertion as if it were a match.",
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "national-id-hash",
            "contact-route",
            "roster-id",
            "manual"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "key",
        "confidence"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "NOTIFIED",
        "ACCEPTED",
        "DISPUTED"
      ],
      "description": "ACCEPTED is reachable by confirm, auto-confirm or supervisor-assisted, and all three release payment (W4). DISPUTED may follow ACCEPTED \u2014 silence is not consent against the worker (W3)."
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "windowOpenedAt": {
          "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
        },
        "windowClosesAt": {
          "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
        },
        "route": {
          "type": "string",
          "enum": [
            "self",
            "auto",
            "assisted",
            "review"
          ]
        },
        "at": {
          "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
        },
        "notifiedAt": {
          "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
        }
      },
      "required": [
        "windowOpenedAt",
        "windowClosesAt"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
    }
  },
  "required": [
    "id",
    "unitId",
    "partyId",
    "state",
    "createdAt"
  ],
  "additionalProperties": false
}
