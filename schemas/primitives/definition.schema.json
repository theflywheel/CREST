{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crest:schema:primitives:definition:1",
  "title": "Definition",
  "description": "What counts as a completed instance of an activity, what evidence proves it at which strength, who may attest. Versioned, immutable once ACTIVE, three faces of one signed record (§7).",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RATIFIED",
        "ACTIVE",
        "SUPERSEDED"
      ]
    },
    "activity": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "label"
      ],
      "additionalProperties": false
    },
    "skillCode": {
      "type": "string",
      "pattern": "^CREST-SKILL:[a-z0-9]+(\\.[a-z0-9-]+)*\\.v[0-9]+$",
      "description": "The skill this definition evidences (urn:crest:schema:reference:skill:1).\n\nDistinct from `activity`, which names what this definition is about in this deployment's own words. The skill code is the part that means the same thing somewhere else — it is what makes a worker's record portable across programmes and eventually across borders, and `activity.code` deliberately is not.\n\nOPTIONAL, because a deployment can define work before it has adopted a skill taxonomy, and refusing to let it record work until it has is the wrong trade for a worker whose payment depends on the record existing. A definition with no skill code produces credentials with no skill code, which are still perfectly valid evidence of the work — just not yet portable in the way §3 intends."
    },
    "outcomeUnit": {
      "type": "string",
      "minLength": 1,
      "description": "The unit a Unit's outcome is counted in. Comes from here, never from a source system."
    },
    "faces": {
      "type": "object",
      "description": "Three projections of one record, never three documents (§7).",
      "properties": {
        "worker": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "evidenceInPlainLanguage": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tierCeiling": {
              "$ref": "urn:crest:schema:primitives:common:1#/$defs/tier"
            }
          },
          "required": [
            "summary",
            "evidenceInPlainLanguage",
            "tierCeiling"
          ],
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "properties": {
            "sourceSystems": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requiredFields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "schemaRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "sourceSystems",
            "requiredFields",
            "schemaRef"
          ],
          "additionalProperties": false
        },
        "verifier": {
          "type": "object",
          "properties": {
            "authorisedIssuers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "specifierPartyId": {
              "$ref": "urn:crest:schema:primitives:common:1#/$defs/did"
            },
            "specifiedAt": {
              "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
            }
          },
          "required": [
            "authorisedIssuers",
            "specifierPartyId",
            "specifiedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "worker",
        "platform",
        "verifier"
      ],
      "additionalProperties": false
    },
    "tierMap": {
      "type": "array",
      "minItems": 1,
      "description": "L2 data read by the L1 strength function (§6). Rules are evaluated in order; the first whose conditions all hold gives the tier. The function is identical everywhere; this table is not.",
      "items": {
        "type": "object",
        "properties": {
          "tier": {
            "$ref": "urn:crest:schema:primitives:common:1#/$defs/tier"
          },
          "sourceClassIn": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:crest:schema:primitives:common:1#/$defs/sourceClass"
            }
          },
          "captureMethodIn": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:crest:schema:primitives:common:1#/$defs/captureMethod"
            }
          },
          "requiresFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minIdentityAssurance": {
            "$ref": "urn:crest:schema:primitives:common:1#/$defs/identityAssurance"
          }
        },
        "required": [
          "tier",
          "sourceClassIn",
          "captureMethodIn"
        ],
        "additionalProperties": false
      }
    },
    "authorisedAttesterFunctions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "An Authorization must carry one of these functions to submit evidence against this definition."
    },
    "authoredByPartyId": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/did"
    },
    "ratifiedByPartyId": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/did",
      "description": "Must differ from authoredByPartyId. Separation of duties is an L1 rule enforced in the definitions service, not left to product UI (§7)."
    },
    "activatedAt": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
    },
    "supersededBy": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/versionedRef"
    },
    "createdAt": {
      "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp"
    }
  },
  "required": [
    "id",
    "version",
    "state",
    "activity",
    "outcomeUnit",
    "faces",
    "tierMap",
    "authorisedAttesterFunctions",
    "authoredByPartyId",
    "createdAt"
  ],
  "additionalProperties": false
}
