{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crest:schema:credentials:work-event-credential:1",
  "title": "WorkEventCredential",
  "description": "The credential a worker holds (§5). It carries provenance facts and never a tier: the tier is computed at presentation time against the pinned definition version, so re-assessing a compromised source downgrades every affected credential instantly without reissuance (§6).",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" },
      "description": "W3C VC context plus CREST's own."
    },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "['VerifiableCredential', 'WorkEventCredential']"
    },
    "issuer": { "type": "string", "minLength": 1 },
    "validFrom": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The pairwise subject reference. Never a national identifier, and never a name (W8, W9)."
        },
        "workEvent": {
          "type": "object",
          "properties": {
            "eventId": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/id" },
            "definition": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/versionedRef" },
            "activity": { "type": "string", "minLength": 1 },
            "outcome": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/outcome" },
            "period": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/period" },
            "geography": { "type": "string" }
          },
          "required": ["eventId", "definition", "activity", "outcome", "period"],
          "additionalProperties": false
        },
        "provenance": {
          "$ref": "urn:crest:schema:primitives:common:1#/$defs/provenance",
          "description": "The facts the strength function reads. A credential that stated its own tier would freeze a judgement verifiers must be free to make differently."
        },
        "confirmation": {
          "type": "object",
          "properties": {
            "route": { "type": "string", "enum": ["self", "auto", "assisted"] },
            "at": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp" }
          },
          "required": ["route", "at"],
          "additionalProperties": false,
          "description": "Which route accepted the claim. A verifier can see that a credential was auto-confirmed rather than actively confirmed, and weigh it."
        }
      },
      "required": ["id", "workEvent", "provenance", "confirmation"],
      "additionalProperties": false
    },
    "credentialStatus": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "BitstringStatusListEntry" },
        "statusPurpose": { "const": "revocation" },
        "statusListIndex": { "type": "string" },
        "statusListCredential": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "type", "statusPurpose", "statusListIndex", "statusListCredential"],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": {
          "const": "eddsa-jcs-2022",
          "description": "Ed25519 over JCS-canonicalised JSON. Chosen over the JSON-LD suite because verifying that one requires resolving a context document, and a verifier that must fetch a URL is not offline (W6)."
        },
        "created": { "$ref": "urn:crest:schema:primitives:common:1#/$defs/timestamp" },
        "verificationMethod": { "type": "string", "minLength": 1 },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "cryptosuite", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "additionalProperties": false
    }
  },
  "required": ["@context", "id", "type", "issuer", "validFrom", "credentialSubject", "credentialStatus"],
  "additionalProperties": false
}
